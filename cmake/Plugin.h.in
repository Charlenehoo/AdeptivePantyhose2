// cmake/Plugin.h.in

#pragma once

#include <REL/Relocation.h>
#include <string_view>

namespace Plugin {
inline constexpr REL::Version kVersion {
    // clang-format off
    @PROJECT_VERSION_MAJOR@u,
    @PROJECT_VERSION_MINOR@u,
    @PROJECT_VERSION_PATCH@u,
    // clang-format on
};

inline constexpr std::string_view kName{"@PROJECT_NAME@"};
inline constexpr const char* kNameCStr = "@PROJECT_NAME@";
inline constexpr std::string_view kAuthor{"@PROJECT_AUTHOR@"};
inline constexpr std::string_view kAuthorEmail{"@PROJECT_AUTHOR_EMAIL@"};

}  // namespace Plugin
